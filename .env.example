# Copy to .env for local development. On Replit, set these as Secrets instead.
# Leave ANTHROPIC_API_KEY unset to run in browser-only mode (no AI).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5        # match + CV suggestions (quality tier)
ANTHROPIC_MODEL_FAST=claude-haiku-5-5    # gap interview, questions, review, scan summary (~20x cheaper)
ANTHROPIC_EFFORT=low                      # low | medium | high — thinking effort on Claude 5.x
# anthropic | mock | off   (default: anthropic when a key is set, otherwise off)
ROLEDONE_PROVIDER=
PORT=3000
# free | pro | premium — plan every visitor gets until accounts exist (testing only)
ROLEDONE_DEFAULT_PLAN=free

# Stripe (leave unset to run without billing). Test keys first; repeat prices + webhook in live mode later.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
APP_URL=https://roledone.com
# optional: separate secret for signing entitlement tokens (defaults to the webhook secret)
ROLEDONE_TOKEN_SECRET=

# Supabase (accounts). Leave unset to run without sign-in (subscriptions then live per device).
SUPABASE_URL=
SUPABASE_ANON_KEY=        # publishable key (safe for the browser)
SUPABASE_SERVICE_KEY=     # secret key — server only
# comma-separated emails that get every feature without paying (you, testers)
ROLEDONE_ADMIN_EMAILS=

# Job search (optional). With Adzuna keys: UK, US and 17 other countries with salaries.
# Free keys at https://developer.adzuna.com. Without them, Arbeitnow (remote/Europe tech, no key) is used.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Canonical URL for blog pages and the sitemap (default https://roledone.com)
APP_URL=
